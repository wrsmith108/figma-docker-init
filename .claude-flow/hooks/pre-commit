#!/bin/bash
#
# Pre-Commit Hook: AI-Powered Validation
#
# Runs AI validation before allowing commit.
# Uses learned patterns from AgentDB to predict CI/CD failures.
#
# To bypass (not recommended): git commit --no-verify
#

set -e

echo ""
echo "🔍 Running AI pre-commit validation..."
echo ""

# Run AI validation script
node scripts/ai-validate.js

exit_code=$?

if [ $exit_code -eq 0 ]; then
  echo ""
  echo "✅ Pre-commit validation passed"
  echo ""
else
  echo ""
  echo "❌ Pre-commit validation failed"
  echo ""
  echo "To bypass (not recommended): git commit --no-verify"
  echo "To see details: node scripts/ai-validate.js --verbose"
  echo ""
  exit 1
fi
