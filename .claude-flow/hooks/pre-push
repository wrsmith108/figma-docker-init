#!/bin/bash
#
# Pre-Push Hook: Final AI Validation with Byzantine Consensus
#
# Last line of defense before code reaches GitHub Actions.
# Uses Byzantine fault-tolerant consensus for maximum confidence.
#
# To bypass (STRONGLY not recommended): git push --no-verify
#

set -e

echo ""
echo "🛡️  Running Byzantine consensus validation..."
echo ""

# Run AI validation in strict mode (requires 100% approval)
node scripts/ai-validate.js --strict --verbose

exit_code=$?

if [ $exit_code -eq 0 ]; then
  echo ""
  echo "✅ Byzantine consensus achieved - safe to push"
  echo ""
else
  echo ""
  echo "❌ Byzantine consensus FAILED"
  echo ""
  echo "This is the last line of defense before GitHub Actions."
  echo "Pushing now will likely result in CI/CD failures."
  echo ""
  echo "Recommended actions:"
  echo "  1. Review agent feedback above"
  echo "  2. Fix identified issues"
  echo "  3. Run: npm test"
  echo "  4. Try push again"
  echo ""
  echo "To bypass (NOT RECOMMENDED): git push --no-verify"
  echo ""
  exit 1
fi
