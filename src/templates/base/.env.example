# =============================================================================
# vibe-to-docker Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env file with real secrets to version control
#
# Variable Priority:
#   1. Environment variables (highest)
#   2. .env file
#   3. Default values (lowest)
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Port the application will listen on
PORT=3000

# Environment mode (development, production, test)
NODE_ENV=production

# Host binding (0.0.0.0 for Docker, localhost for local dev)
HOST=0.0.0.0

# Application title/name
APP_TITLE=My Application

# -----------------------------------------------------------------------------
# Build Configuration (Vite/React/Next.js)
# -----------------------------------------------------------------------------
# API endpoint URL for frontend builds
# VITE_API_URL=http://localhost:3000/api
# REACT_APP_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Public assets URL (CDN or local)
# PUBLIC_URL=https://cdn.example.com
# VITE_PUBLIC_PATH=/

# Enable/disable source maps in production
# GENERATE_SOURCEMAP=false

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# MongoDB connection string
# MONGODB_URI=mongodb://localhost:27017/database_name

# Redis connection (caching, sessions)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password

# -----------------------------------------------------------------------------
# API Keys & External Services
# -----------------------------------------------------------------------------
# ⚠️  SECURITY WARNING: Never commit real API keys to version control
# Use environment variables or secrets management in production

# Example API keys (replace with your actual keys)
# API_KEY=your_api_key_here
# API_SECRET=your_api_secret_here

# Third-party services
# STRIPE_PUBLIC_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# SENDGRID_API_KEY=SG...
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# S3_BUCKET=my-bucket

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Session secret (generate random string: openssl rand -base64 32)
# SESSION_SECRET=your_very_long_random_session_secret_here

# JWT token secret (generate random string: openssl rand -base64 64)
# JWT_SECRET=your_very_long_random_jwt_secret_here
# JWT_EXPIRES_IN=7d

# Cookie settings
# COOKIE_SECURE=true
# COOKIE_HTTP_ONLY=true
# COOKIE_SAME_SITE=strict

# CORS allowed origins (comma-separated)
# CORS_ORIGIN=https://example.com,https://app.example.com

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable features without code changes
# ENABLE_ANALYTICS=false
# ENABLE_DEBUG=false
# ENABLE_EXPERIMENTAL_FEATURES=false
# ENABLE_RATE_LIMITING=true
# ENABLE_CACHING=true

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level (error, warn, info, debug, trace)
LOG_LEVEL=info

# Log format (json, pretty)
# LOG_FORMAT=json

# Log file path (leave empty to log to stdout only)
# LOG_FILE=/var/log/app.log

# Enable request logging
# LOG_REQUESTS=true

# -----------------------------------------------------------------------------
# Docker & Build Configuration
# -----------------------------------------------------------------------------
# Enable BuildKit for better Docker builds
DOCKER_BUILDKIT=1

# Enable Docker CLI build with BuildKit
COMPOSE_DOCKER_CLI_BUILD=1

# Docker image tag
# DOCKER_IMAGE_TAG=latest

# Build arguments (passed to docker build)
# BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
# VERSION=1.0.0

# -----------------------------------------------------------------------------
# Performance & Resource Limits
# -----------------------------------------------------------------------------
# Node.js memory limit (in MB)
# NODE_OPTIONS=--max-old-space-size=4096

# Worker threads (0 = auto-detect CPU cores)
# WORKER_THREADS=0

# Request timeout (milliseconds)
# REQUEST_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Enable hot module replacement
# HMR_ENABLED=true

# Development server port
# DEV_SERVER_PORT=5173

# Enable source maps in development
# DEV_SOURCE_MAPS=true

# -----------------------------------------------------------------------------
# Production Optimizations
# -----------------------------------------------------------------------------
# Enable compression
# COMPRESSION_ENABLED=true

# Enable HTTP/2 server push
# HTTP2_PUSH=true

# Cache control max-age (seconds)
# CACHE_MAX_AGE=31536000

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# Application Performance Monitoring (APM)
# APM_SERVER_URL=https://apm.example.com
# APM_SERVICE_NAME=my-app

# Error tracking (Sentry, etc.)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production

# Health check endpoint path
# HEALTH_CHECK_PATH=/health

# -----------------------------------------------------------------------------
# Platform-Specific Configuration
# -----------------------------------------------------------------------------
# Vercel
# VERCEL_URL=auto-generated-by-vercel.app
# VERCEL_ENV=production

# Railway
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PUBLIC_DOMAIN=app.railway.app

# Render
# RENDER=true
# RENDER_EXTERNAL_URL=https://app.onrender.com

# Heroku
# HEROKU_APP_NAME=my-app
# DYNO=web.1

# -----------------------------------------------------------------------------
# Custom Application Variables
# -----------------------------------------------------------------------------
# Add your project-specific environment variables below
# Organize them into logical groups with comments
# Example:
# FEATURE_X_ENABLED=true
# FEATURE_X_API_KEY=xxx
