# Multi-stage Dockerfile for {{TOOL}} projects
# Generated by vibe-to-docker

# Stage 1: Dependencies
FROM node:{{NODE_VERSION}}-alpine@sha256:6178e78b972f79c335df281f4b7674a2d85071aae2af020ffa39f0a770265435 AS deps
LABEL org.opencontainers.image.source="https://github.com/wrsmith108/vibe-to-docker"
LABEL org.opencontainers.image.version="{{VERSION}}"
LABEL org.opencontainers.image.description="Docker container for {{PROJECT_NAME}}"
LABEL org.opencontainers.image.created="{{BUILD_DATE}}"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.vendor="vibe-to-docker"

# Install system dependencies
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy package files
COPY package*.json ./
{{#if YARN}}
COPY yarn.lock ./
{{/if}}
{{#if PNPM}}
COPY pnpm-lock.yaml ./
{{/if}}

# Install dependencies
RUN {{INSTALL_COMMAND}}

# Stage 2: Builder
FROM node:{{NODE_VERSION}}-alpine@sha256:6178e78b972f79c335df281f4b7674a2d85071aae2af020ffa39f0a770265435 AS builder
LABEL org.opencontainers.image.source="https://github.com/wrsmith108/vibe-to-docker"
LABEL org.opencontainers.image.version="{{VERSION}}"
LABEL org.opencontainers.image.description="Docker container for {{PROJECT_NAME}}"
LABEL org.opencontainers.image.created="{{BUILD_DATE}}"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.vendor="vibe-to-docker"

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy configuration files first (better layer caching)
COPY package*.json ./
{{#if YARN}}
COPY yarn.lock ./
{{/if}}
{{#if PNPM}}
COPY pnpm-lock.yaml ./
{{/if}}

# Copy build configuration files
COPY tsconfig*.json ./
COPY vite.config.* ./
COPY *.config.js ./
COPY *.config.ts ./

# Copy source files
COPY src ./src
# Copy public/ if exists (optional for some frameworks)
COPY public ./public 2>/dev/null || mkdir -p ./public
COPY index.html ./

# Build application
{{#if BUILD_ENV_VARS}}
# Build-time environment variables
{{BUILD_ENV_VARS}}
{{/if}}

RUN {{BUILD_COMMAND}}

# Stage 3: Production runtime
FROM node:{{NODE_VERSION}}-alpine@sha256:6178e78b972f79c335df281f4b7674a2d85071aae2af020ffa39f0a770265435 AS production
LABEL org.opencontainers.image.source="https://github.com/wrsmith108/vibe-to-docker"
LABEL org.opencontainers.image.version="{{VERSION}}"
LABEL org.opencontainers.image.description="Docker container for {{PROJECT_NAME}}"
LABEL org.opencontainers.image.created="{{BUILD_DATE}}"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.vendor="vibe-to-docker"

WORKDIR /app

# Set NODE_ENV
ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 appuser

# Copy built application
{{#if STATIC_BUILD}}
# Copy static files for serving
COPY --from=builder --chown=appuser:nodejs /app/dist ./dist
COPY --from=builder --chown=appuser:nodejs /app/package*.json ./
COPY --from=builder --chown=appuser:nodejs /app/serve.json ./serve.json
{{/if}}
{{#if SERVER_BUILD}}
# Copy server build
COPY --from=builder --chown=appuser:nodejs /app/.next ./.next
COPY --from=builder --chown=appuser:nodejs /app/public ./public
COPY --from=builder --chown=appuser:nodejs /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
{{/if}}

{{#if STATIC_BUILD}}
# Install serve for static file serving (as root before USER switch)
RUN npm install -g serve@14.2.1
{{/if}}

# Switch to non-root user
USER appuser

# Expose port
EXPOSE {{PORT}}

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:{{PORT}}/', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

{{#if STATIC_BUILD}}
# Start static file server with compression and caching
CMD ["serve", "-s", "dist", "-l", "{{PORT}}", "-c", "serve.json"]
{{/if}}
{{#if SERVER_BUILD}}
# Start application server
CMD ["{{START_COMMAND}}"]
{{/if}}
