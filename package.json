{
  "name": "vibe-to-docker",
  "version": "3.0.3",
  "description": "Docker containerization for AI-generated projects with failure pattern mitigation. 24 features addressing 82% dependency conflicts, 60-70% environment mismatches, 48% hardcoded secrets in Lovable/Bolt/V0/Figma code.",
  "main": "vibe-to-docker.js",
  "type": "module",
  "bin": {
    "vibe-to-docker": "vibe-to-docker.js"
  },
  "scripts": {
    "start": "node vibe-to-docker.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:coverage:watch": "node --experimental-vm-modules node_modules/.bin/jest --coverage --watch",
    "coverage:report": "node --experimental-vm-modules node_modules/.bin/jest --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=html",
    "coverage:open": "node --experimental-vm-modules node_modules/.bin/jest --coverage && open coverage/lcov-report/index.html",
    "semantic-release": "semantic-release"
  },
  "keywords": [
    "vibe-coding",
    "figma",
    "lovable",
    "bolt",
    "v0",
    "docker",
    "react",
    "vite",
    "typescript",
    "quick-start",
    "template",
    "cli",
    "containerization",
    "devops",
    "frontend",
    "fullstack",
    "development",
    "ai-generated"
  ],
  "author": {
    "name": "Vibe to Docker Team",
    "email": "support@vibe-to-docker.dev",
    "url": "https://github.com/wrsmith108"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrsmith108/vibe-to-docker.git"
  },
  "bugs": {
    "url": "https://github.com/wrsmith108/vibe-to-docker/issues"
  },
  "homepage": "https://github.com/wrsmith108/vibe-to-docker",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wrsmith108"
  },
  "engines": {
    "node": ">=20.8.1",
    "npm": ">=10.0.0"
  },
  "files": [
    "vibe-to-docker.js",
    "src/lib/",
    "src/detectors/",
    "src/templates/",
    "templates/",
    "README.md",
    "LICENSE",
    "package-lock.json"
  ],
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "agentdb": "^1.6.1",
    "agentic-flow": "^1.10.2",
    "babel-jest": "^30.2.0",
    "claude-flow": "^2.7.33",
    "fs-extra": "^11.3.2",
    "jest": "^30.2.0",
    "js-yaml": "^4.1.1",
    "semantic-release": "^25.0.2"
  },
  "overrides": {
    "test-exclude": "^7.0.1",
    "glob": "^10.4.5",
    "claude-flow": {
      "glob": "^10.4.5"
    }
  },
  "preferGlobal": true,
  "release": {
    "branches": [
      "pack-master",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": true
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "*.tgz",
              "label": "npm package"
            }
          ]
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
